{
  "expo": {
    "name": "Project 90",
    "slug": "project-90",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "project90",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zach.project90",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Project 90 to access your photos to save progress pictures.",
          "cameraPermission": "Allow Project 90 to use your camera for progress pictures."
        }
      ]
    ]
  }
}
