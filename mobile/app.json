{
  "expo": {
    "name": "Project 90",
    "slug": "project-90",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "project90",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zach.project90"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Project 90 to access your photos to save progress pictures.",
          "cameraPermission": "Allow Project 90 to use your camera for progress pictures."
        }
      ]
    ]
  }
}
